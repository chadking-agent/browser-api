# --- Paths (defaults are XDG-style under ~/.local/share/browser-api/) ---
# BROWSER_API_PROFILE_DIR=~/.local/share/browser-api/profiles
#   (base dir; each provider gets its own subdir, e.g. .../profiles/gemini)
# BROWSER_API_LOGS_DIR=~/.local/share/browser-api/logs
# BROWSER_API_CACHE_DIR=~/.local/share/browser-api/cache
# BROWSER_API_CONFIG_DIR=~/.local/share/browser-api/config
# BROWSER_API_BASE_DIR=~/.local/share/browser-api

# --- Server ---
# BROWSER_API_HOST=127.0.0.1       # keep loopback; no auth unless key is set
# BROWSER_API_PORT=54706
# BROWSER_API_API_KEY=             # if set, all routes require Bearer <key>
# BROWSER_API_MAX_BODY_BYTES=8388608

# --- Provider selection ---
# BROWSER_API_PROVIDER=gemini      # default provider for /v1/chat/completions

# --- Browser ---
# BROWSER_API_HEADLESS=true               # set false for first-run login
# BROWSER_API_CHROME_EXECUTABLE=          # path to Chrome/Chromium; default channel "chrome"

# --- Model ids (informational; the logged-in profile's active model is used) ---
# BROWSER_API_GEMINI_MODEL=gemini-3.6
# BROWSER_API_GEMINI_MODEL_ALIASES=gemini-3.6,gemini-3.5-flash-lite
# (per-provider: BROWSER_API_<PROVIDER>_MODEL / _MODEL_ALIASES)
